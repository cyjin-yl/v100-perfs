+    maximum = max(maximum, __shfl_down_sync(0xffffffffu, maximum, offset));
+    nan_count += __shfl_down_sync(0xffffffffu, nan_count, offset);
+    active |= __shfl_down_sync(0xffffffffu, active, offset);
