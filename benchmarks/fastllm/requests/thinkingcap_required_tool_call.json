              }
            },
            "required": [
              "city"
            ],
            "additionalProperties": false
          }
        }
      }
    ],
    "tool_choice": "auto",
    "temperature": 0.0,
    "max_tokens": 512,
    "stream": true,
    "stream_options": {
      "include_usage": true
    }
  }
