     assert step.num_scheduled_tokens[resident.request_id] == 1
     assert step.num_scheduled_tokens["long"] == 768
     assert step.mixed_prefill_budget == 768
+
+
+def test_mixed_prefill_recovers_without_interrupting_resident_decode():
+    scheduler = create_scheduler(
+        max_num_batched_tokens=8192, long_prefill_token_threshold=256
+    )
+    scheduler.mixed_prefill_enabled = True
+    resident = create_requests(
+        num_requests=1, num_tokens=32, max_tokens=64, req_ids=["resident"]
+    )[0]
+    prefills = create_requests(
+        num_requests=2, num_tokens=1536, req_ids=["long-a", "long-b"]
+    )
+    requests = [resident, *prefills]
+    for request in requests:
+        scheduler.add_request(request)
+
+    def complete(step, elapsed_ms=None):
+        ids = list(step.num_scheduled_tokens)
+        scheduler.update_from_output(
+            step,
+            ModelRunnerOutput(
+                req_ids=ids,
+                req_id_to_index={req_id: i for i, req_id in enumerate(ids)},
+                sampled_token_ids=[
+                    [42] if req_id == resident.request_id else [] for req_id in ids
+                ],
+                mixed_prefill_timing=(
+                    None
+                    if elapsed_ms is None
+                    else MixedPrefillTiming(
+                        step.mixed_prefill_tokens,
+                        step.mixed_decode_tokens,
+                        step.mixed_prefill_budget,
+                        elapsed_ms,
+                    )
+                ),
+            ),
+        )
+
+    complete(scheduler.schedule())
+    assert all(0 < r.num_computed_tokens < r.num_prompt_tokens for r in prefills)
+    target_ms = scheduler.scheduler_config.mixed_prefill_step_latency_ms
+    slow = scheduler.schedule()
+    # Synthetic full-budget feedback forces the 16-token floor.
+    complete(slow, 2 * target_ms * slow.mixed_prefill_tokens / 16)
+    grants = []
+    for _ in range(16):
+        step = scheduler.schedule()
+        grant = sum(step.num_scheduled_tokens.get(r.request_id, 0) for r in prefills)
+        assert step.num_scheduled_tokens.get(resident.request_id, 0) > 0
+        assert all(r.num_preemptions == 0 for r in requests)
+        assert all(r.num_computed_tokens < r.num_prompt_tokens for r in prefills)
+        grants.append(grant)
+        complete(step, target_ms / 4)
+        if grant > 16:
+            break
+
+    assert grants[0] == 16
+    assert max(grants) > 16
