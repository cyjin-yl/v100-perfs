+@pytest.mark.parametrize("storage_dtype", [torch.uint8, torch.float8_e4m3fn])
+@pytest.mark.parametrize("compact", [False, True])
+@torch.inference_mode()
+def test_packed_projection_keeps_activation_precision(storage_dtype, compact):
+    class PackedProjection(torch.nn.Module):
+        def __init__(self):
+            super().__init__()
+            self.input_size = 160
+            self.params_dtype = torch.float16
+            self.quant_method = SimpleNamespace()
+            self.weight = torch.nn.Parameter(
+                torch.empty(0, dtype=storage_dtype), requires_grad=False
+            )
+            self.register_buffer(
+                "codes", torch.arange(32 * 160).reshape(32, 160).remainder(17).to(torch.int8) - 8
+            )
+
+        def forward(self, inputs):
+            decoded = (self.codes.float() / 32).half()
+            return torch.nn.functional.linear(inputs, decoded)
+
+    model = Projection("cpu", torch.float16)
+    model.model.fc = PackedProjection()
+    model._sampling_policy.compact_aux_hidden = compact
+    aux = [torch.arange(8 * 64, dtype=torch.float32).reshape(8, 64)[:, ::2] / 128
+           for _ in range(5)]
+    expected = model.model.fc(torch.cat(aux, dim=-1).half())
+    actual = model.combine_aux_hidden_states(aux)
+    torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+
