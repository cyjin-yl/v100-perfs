---
import manifest from "../data/content-manifest.json";
import "../styles/global.css";

export interface Props { title?: string; }

const { title = "V100 FastLLM documentation" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const overview = manifest.find((item) => item.source_path === "docs/index.md");
if (!overview) throw new Error("Manifest is missing docs/index.md");

const currentCanonical = manifest
  .filter((item) => item.status === "current" && item.authority === "canonical")
  .sort((left, right) =>
    (left.nav_order ?? Number.MAX_SAFE_INTEGER) - (right.nav_order ?? Number.MAX_SAFE_INTEGER) ||
    left.source_path.localeCompare(right.source_path)
  );

const navigationSpec = [
  { section: "overview", label: "Overview" },
  { section: "getting-started", label: "Getting Started" },
  { section: "concepts", label: "Concepts" },
  { section: "guides", label: "Guides" },
  { section: "operations", label: "Operations" },
  { section: "reference", label: "Reference" },
  { section: "performance", label: "Performance" },
  { section: "research", label: "Research" },
  { section: "archive", label: "Archive" },
  { section: "repository", label: "Repository" },
] as const;

const navigation = navigationSpec.map(({ section, label }) => {
  if (section === "repository") return { section, label, route: "/repo" };
  const entry = currentCanonical.find((item) => item.nav_section === section);
  return {
    section,
    label,
    route: entry?.canonical_route ?? `${overview.canonical_route}#${section}`,
  };
});

function deployedRoute(route: string) {
  const [path, fragment] = route.split("#", 2);
  const encodedPath = path
    .split("/")
    .map((part, index) => index === 0 ? "" : encodeURIComponent(part))
    .join("/");
  return `${base}${encodedPath || "/"}${fragment ? `#${fragment}` : ""}`;
}

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const relativePath = currentPath.startsWith(base)
  ? currentPath.slice(base.length) || "/"
  : currentPath;
const currentItem = manifest.find((item) => {
  const canonical = deployedRoute(item.canonical_route).split("#", 1)[0].replace(/\/$/, "") || "/";
  const repository = deployedRoute(item.repository_route).replace(/\/$/, "") || "/";
  return currentPath === canonical || currentPath === repository;
});
const activeSection = relativePath === "/"
  ? "overview"
  : relativePath === "/repo" || relativePath.startsWith("/repository/")
    ? "repository"
    : relativePath.startsWith("/archive/")
      ? "archive"
      : currentItem?.nav_section ?? (
        currentItem?.source_path.startsWith("docs/research/") ? "research" : null
      );

const related = currentPath === `${base}` || relativePath === "/"
  ? []
  : currentCanonical
      .filter((item) => item.source_path !== currentItem?.source_path)
      .sort((left, right) => {
        const leftSame = left.nav_section === activeSection ? 0 : 1;
        const rightSame = right.nav_section === activeSection ? 0 : 1;
        return leftSame - rightSame ||
          (left.nav_order ?? Number.MAX_SAFE_INTEGER) - (right.nav_order ?? Number.MAX_SAFE_INTEGER) ||
          left.source_path.localeCompare(right.source_path);
      })
      .slice(0, 3);

const breadcrumbSection = navigation.find((item) => item.section === activeSection);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Canonical operating and reference documentation for the V100 FastLLM repository." />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <div class="shell">
      <aside class="site-rail">
        <a class="brand" href={deployedRoute("/")}>
          <span class="brand-mark" aria-hidden="true">V100</span>
          <span>FastLLM documentation</span>
          <small>Canonical source, evidence, archive</small>
        </a>
        <nav class="primary-nav" aria-label="Primary">
          {navigation.map((item) => (
            <a
              href={deployedRoute(item.route)}
              aria-current={activeSection === item.section ? "page" : undefined}
            >
              <span aria-hidden="true">{String(navigation.indexOf(item) + 1).padStart(2, "0")}</span>
              {item.label}
            </a>
          ))}
        </nav>
        <p class="manifest-note">
          <strong>{manifest.length}</strong> tracked paths<br />
          one generated manifest
        </p>
      </aside>
      <main id="content">
        {relativePath !== "/" && (
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href={deployedRoute(overview.canonical_route)}>Overview</a>
            {breadcrumbSection && breadcrumbSection.section !== "overview" && (
              <>
                <span aria-hidden="true">/</span>
                <a href={deployedRoute(breadcrumbSection.route)}>{breadcrumbSection.label}</a>
              </>
            )}
            {currentItem && (
              <>
                <span aria-hidden="true">/</span>
                <span aria-current="page">{currentItem.title}</span>
              </>
            )}
          </nav>
        )}
        <slot />
        {related.length > 0 && (
          <aside class="related-docs" aria-labelledby="related-title">
            <p class="eyebrow">From the content manifest</p>
            <h2 id="related-title">Related canonical docs</h2>
            <div>
              {related.map((item) => (
                <a href={deployedRoute(item.canonical_route)}>
                  <strong>{item.title}</strong>
                  <span>{item.summary}</span>
                </a>
              ))}
            </div>
          </aside>
        )}
      </main>
    </div>
  </body>
</html>
