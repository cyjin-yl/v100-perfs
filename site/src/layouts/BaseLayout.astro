---
import "../styles/global.css";
export interface Props { title?: string; }
const { title = "V100-32G FastLLM Docs" } = Astro.props;
const nav = [
  { href: "/v100-perfs/", label: "首页" },
  { href: "/v100-perfs/docs/getting-started", label: "快速开始" },
  { href: "/v100-perfs/docs/architecture", label: "架构" },
  { href: "/v100-perfs/docs/toolcall", label: "工具调用" },
  { href: "/v100-perfs/docs/performance", label: "性能数据" },
  { href: "/v100-perfs/docs/ops", label: "运维手册" },
  { href: "/v100-perfs/llms.txt", label: "llms.txt (LLM)" },
];
---
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <aside>
        <a class="brand" href="/v100-perfs/">V100·32G<br /><small>FastLLM 推理记录</small></a>
        <nav>
          {nav.map((n) => (
            <a href={n.href}>{n.label}</a>
          ))}
        </nav>
        <div class="proto-note">UI: Proto-UI / shadcn</div>
      </aside>
      <main><slot /></main>
    </div>
    <style define:vars={{}}>
      .shell { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; }
      aside {
        border-right: 1px solid hsl(var(--border));
        padding: 18px 14px;
        position: sticky; top: 0; height: 100vh; overflow-y: auto;
      }
      .brand { font-weight: 700; color: hsl(var(--foreground)); display:block; margin-bottom:18px; line-height:1.3;}
      .brand small { color: hsl(var(--muted-foreground)); font-weight:400; font-size:12px; }
      nav a { display:block; padding:6px 10px; border-radius: var(--radius); color:hsl(var(--muted-foreground)); font-size:14px; }
      nav a:hover, nav a[aria-current="page"] { background:hsl(var(--card)); color:hsl(var(--foreground)); text-decoration:none; }
      main { padding: 28px 36px; max-width: 980px; }
      .proto-note { margin-top:24px; font-size:11px; color:hsl(var(--muted-foreground)); }
      @media (max-width:800px){ .shell{grid-template-columns:1fr} aside{position:static;height:auto} }
    </style>
  </body>
</html>
